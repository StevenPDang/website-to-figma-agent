            "sourceUrl": {
              "type": "string",
              "format": "uri",
              "maxLength": 8192
            },
            "capturedAt": { "type": "string", "format": "date-time" },
            "viewport": { "$ref": "#/$defs/viewport" },
            "payload": { "type": "object" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "schemaVersion": { "const": "1.0.0" } },
                "required": ["schemaVersion"]
              },
              "then": {
                "properties": {
                  "payload": { "$ref": "#/$defs/legacyInferencePayload" }
