{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://website-to-figma.local/schemas/artifacts/1.0.0",
  "title": "Website-to-Figma Artifact",
  "oneOf": [
    { "$ref": "#/$defs/rawCaptureArtifact" },
    { "$ref": "#/$defs/websiteIrArtifact" },
    { "$ref": "#/$defs/inferenceArtifact" },
    { "$ref": "#/$defs/figmaSceneArtifact" },
    { "$ref": "#/$defs/importResultArtifact" },
    { "$ref": "#/$defs/qaReportArtifact" }
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "properties": {
        "schemaVersion": { "enum": ["1.0.0", "1.1.0"] },
        "artifactKind": {
          "enum": [
            "raw-capture",
            "website-ir",
            "inference",
            "figma-scene",
            "import-result",
            "qa-report"
          ]
        },
        "runId": { "$ref": "#/$defs/stableId" },
        "sourceUrl": { "type": "string", "format": "uri", "maxLength": 8192 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "viewport": { "$ref": "#/$defs/viewport" },
        "payload": { "type": "object" }
      },
      "required": [
        "schemaVersion",
        "artifactKind",
        "runId",
        "sourceUrl",
        "capturedAt",
        "viewport",
        "payload"
      ]
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:.+$",
      "maxLength": 512
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "deviceScaleFactor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        }
      },
      "required": ["width", "height", "deviceScaleFactor"]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "severity": { "enum": ["warning", "error"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sourceNodeId": { "$ref": "#/$defs/stableId" }
      },
      "required": ["code", "severity", "message"]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetId": { "$ref": "#/$defs/stableId" },
        "sourceNodeId": { "$ref": "#/$defs/stableId" },
        "kind": {
          "enum": ["image", "svg", "font", "video", "canvas", "other"]
        },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mimeType": { "type": "string", "maxLength": 256 },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "byteLength": { "type": "integer", "minimum": 0 }
      },
      "required": ["assetId", "sourceNodeId", "kind"]
    },
    "rawNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceNodeId": { "$ref": "#/$defs/stableId" },
        "parentSourceNodeId": {
          "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }]
        },
        "childSourceNodeIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "kind": {
          "enum": ["element", "text", "pseudo-element", "shadow-root"]
        },
        "tagName": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 100000 },
        "rect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          },
          "required": ["x", "y", "width", "height"]
        },
        "visible": { "type": "boolean" },
        "clipped": { "type": "boolean" },
        "zIndex": { "type": "string", "maxLength": 64 },
        "styles": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 4096 }
        },
        "pseudo": { "enum": ["before", "after"] },
        "coordinateSpace": { "const": "document" }
      },
      "required": [
        "sourceNodeId",
        "parentSourceNodeId",
        "childSourceNodeIds",
        "kind"
      ]
    },
    "websiteIrNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": { "$ref": "#/$defs/stableId" },
        "sourceNodeId": { "$ref": "#/$defs/stableId" },
        "parentNodeId": {
          "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }]
        },
        "childNodeIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "kind": {
          "enum": [
            "frame",
            "text",
            "rectangle",
            "ellipse",
            "image",
            "svg",
            "group"
          ]
        },
        "rect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          },
          "required": ["x", "y", "width", "height"]
        },
        "text": { "type": "string", "maxLength": 100000 },
        "styles": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 4096 }
        },
        "visible": { "type": "boolean" }
      },
      "required": [
        "nodeId",
        "sourceNodeId",
        "parentNodeId",
        "childNodeIds",
        "kind"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decisionId": { "$ref": "#/$defs/stableId" },
        "sourceNodeIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "kind": { "enum": ["section", "layout", "component", "token"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "fallback": { "enum": ["geometry", "independent-nodes", "unsupported"] }
      },
      "required": [
        "decisionId",
        "sourceNodeIds",
        "kind",
        "confidence",
        "evidence",
        "fallback"
      ]
    },
    "agentDecision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decisionId": { "$ref": "#/$defs/stableId" },
        "sourceNodeIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "kind": {
          "enum": [
            "section",
            "layout",
            "component",
            "carousel",
            "typography",
            "semantic-name",
            "responsive",
            "fallback",
            "qa-priority",
            "token"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "fallback": {
          "enum": ["geometry", "independent-nodes", "unsupported"]
        },
        "origin": { "enum": ["deterministic", "agent"] },
        "payload": { "type": "object" }
      },
      "required": [
        "decisionId",
        "sourceNodeIds",
        "kind",
        "confidence",
        "evidence",
        "fallback",
        "origin",
        "payload"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "section" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/sectionDecisionPayload" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "layout" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/layoutDecisionPayload" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "component" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/componentDecisionPayload" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "carousel" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/carouselDecisionPayload" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "typography" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/typographyDecisionPayload" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "semantic-name" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/semanticNameDecisionPayload" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "responsive" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/responsiveDecisionPayload" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "fallback" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/fallbackDecisionPayload" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "qa-priority" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/qaPriorityDecisionPayload" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "token" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/tokenDecisionPayload" }
            }
          }
        }
      ]
    },
    "sectionDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "navigation",
            "hero",
            "content",
            "gallery",
            "footer",
            "other"
          ]
        }
      },
      "required": ["role"]
    },
    "layoutDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "horizontal",
            "vertical",
            "wrap",
            "grid",
            "freeform",
            "overlay"
          ]
        },
        "gap": { "type": "number", "minimum": 0 },
        "padding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": { "type": "number", "minimum": 0 },
            "right": { "type": "number", "minimum": 0 },
            "bottom": { "type": "number", "minimum": 0 },
            "left": { "type": "number", "minimum": 0 }
          },
          "required": ["top", "right", "bottom", "left"]
        },
        "align": { "enum": ["start", "center", "end", "stretch"] },
        "justify": { "enum": ["start", "center", "end", "space-between"] }
      },
      "required": ["mode"]
    },
    "componentDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "instanceSourceNodeIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "overrideSourceNodeIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        }
      },
      "required": ["name", "instanceSourceNodeIds", "overrideSourceNodeIds"]
    },
    "carouselDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewportSourceNodeId": { "$ref": "#/$defs/stableId" },
        "panelSourceNodeIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "cloneSourceNodeIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "clipContent": { "type": "boolean" }
      },
      "required": [
        "viewportSourceNodeId",
        "panelSourceNodeIds",
        "cloneSourceNodeIds",
        "clipContent"
      ]
    },
    "typographyDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestedFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "substituteFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "weight": { "type": "number", "minimum": 1, "maximum": 1000 },
        "style": { "enum": ["normal", "italic"] },
        "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
        "letterSpacing": { "type": "number" },
        "preserveLineCount": { "type": "boolean" }
      },
      "required": ["preserveLineCount"]
    },
    "semanticNameDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "required": ["name"]
    },
    "responsiveDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "horizontal": { "enum": ["fixed", "fill", "hug", "left-right"] },
        "vertical": { "enum": ["fixed", "fill", "hug", "top-bottom"] },
        "minWidth": { "type": "number", "minimum": 0 },
        "maxWidth": { "type": "number", "minimum": 0 }
      },
      "required": ["horizontal", "vertical"]
    },
    "fallbackDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "representation": { "enum": ["editable", "raster"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "required": ["representation", "reason"]
    },
    "qaPriorityDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "missing-content",
            "overlap",
            "clipping",
            "ordering",
            "geometry",
            "rendering-noise"
          ]
        },
        "priority": { "enum": ["high", "medium", "low"] }
      },
      "required": ["category", "priority"]
    },
    "tokenDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenType": {
          "enum": ["color", "typography", "spacing", "radius", "effect"]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "required": ["tokenType", "name", "value"]
    },
    "legacyInferencePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceNodeIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/decision" }
        }
      },
      "required": ["sourceNodeIds", "decisions"]
    },
    "agenticInferencePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceNodeIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "decisions": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/decision" },
              { "$ref": "#/$defs/agentDecision" }
            ]
          }
        },
        "deterministicDecisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/decision" }
        },
        "proposedDecisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/agentDecision" }
        },
        "rejectedDecisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "decisionId": { "$ref": "#/$defs/stableId" },
              "code": { "type": "string", "minLength": 1, "maxLength": 128 },
              "reason": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "required": ["decisionId", "code", "reason"]
          }
        },
        "mergeOutcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "decisionId": { "$ref": "#/$defs/stableId" },
              "status": { "enum": ["accepted", "rejected", "fallback"] },
              "supersedesDecisionId": { "$ref": "#/$defs/stableId" }
            },
            "required": ["decisionId", "status"]
          }
        }
      },
      "required": [
        "sourceNodeIds",
        "decisions",
        "deterministicDecisions",
        "proposedDecisions",
        "rejectedDecisions",
        "mergeOutcomes"
      ]
    },
    "figmaSceneNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneNodeId": { "$ref": "#/$defs/stableId" },
        "sourceNodeId": { "$ref": "#/$defs/stableId" },
        "parentNodeId": {
          "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }]
        },
        "childNodeIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "kind": {
          "enum": [
            "frame",
            "text",
            "rectangle",
            "ellipse",
            "image",
            "svg",
            "vector",
            "component",
            "instance",
            "group"
          ]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "rect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          },
          "required": ["x", "y", "width", "height"]
        },
        "text": { "type": "string", "maxLength": 100000 },
        "styles": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 4096 }
        },
        "layoutMode": { "enum": ["NONE", "HORIZONTAL", "VERTICAL"] },
        "layoutIntent": {
          "enum": [
            "horizontal",
            "vertical",
            "wrap",
            "grid",
            "freeform",
            "overlay"
          ]
        },
        "layoutWrap": { "type": "boolean" },
        "itemSpacing": { "type": "number", "minimum": 0 },
        "padding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": { "type": "number", "minimum": 0 },
            "right": { "type": "number", "minimum": 0 },
            "bottom": { "type": "number", "minimum": 0 },
            "left": { "type": "number", "minimum": 0 }
          },
          "required": ["top", "right", "bottom", "left"]
        },
        "clipsContent": { "type": "boolean" },
        "componentSourceNodeId": { "$ref": "#/$defs/stableId" },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "horizontal": { "enum": ["fixed", "fill", "hug", "left-right"] },
            "vertical": { "enum": ["fixed", "fill", "hug", "top-bottom"] },
            "minWidth": { "type": "number", "minimum": 0 },
            "maxWidth": { "type": "number", "minimum": 0 },
            "provenance": { "const": "inferred-single-viewport" }
          },
          "required": ["horizontal", "vertical", "provenance"]
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requestedFamily": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "resolvedFamily": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "weight": { "type": "number", "minimum": 1, "maximum": 1000 },
            "style": { "enum": ["normal", "italic"] },
            "preserveLineCount": { "type": "boolean" },
            "expectedLineCount": { "type": "integer", "minimum": 1 }
          },
          "required": [
            "requestedFamily",
            "resolvedFamily",
            "weight",
            "style",
            "preserveLineCount"
          ]
        },
        "fallbackRepresentation": { "enum": ["editable", "raster"] },
        "inferenceDecisionIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "fills": {
          "type": "array",
          "items": { "type": "string", "maxLength": 4096 }
        },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "cornerRadius": { "type": "number", "minimum": 0 },
        "effects": {
          "type": "array",
          "items": { "type": "string", "maxLength": 4096 }
        }
      },
      "required": [
        "sceneNodeId",
        "sourceNodeId",
        "parentNodeId",
        "childNodeIds",
        "kind",
        "name"
      ]
    },
    "importedNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneNodeId": { "$ref": "#/$defs/stableId" },
        "figmaNodeId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "status": { "enum": ["created", "skipped", "failed"] }
      },
      "required": ["sceneNodeId", "status"]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 100000 }
      },
      "required": ["width", "height"]
    },
    "discrepancyRegion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceNodeId": { "$ref": "#/$defs/stableId" },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "required": ["x", "y", "width", "height"]
    },
    "rawCaptureArtifact": {
      "allOf": [
        { "$ref": "#/$defs/metadata" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemaVersion": { "const": "1.0.0" },
            "artifactKind": { "const": "raw-capture" },
            "runId": { "$ref": "#/$defs/stableId" },
            "sourceUrl": {
              "type": "string",
              "format": "uri",
              "maxLength": 8192
            },
            "capturedAt": { "type": "string", "format": "date-time" },
            "viewport": { "$ref": "#/$defs/viewport" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
